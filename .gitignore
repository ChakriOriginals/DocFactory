# Python
.venv/
__pycache__/
*.pyc
.pytest_cache/
.ruff_cache/

# Local config — never commit real endpoints or keys
.env
# Deploy-time credentials (Neon URLs), sourced by hand before terraform.
# The glob matters: a bare `.env.deploy` does NOT match `.env.deploy.bak`, and
# a `git add -A` duly committed two backups full of live passwords. Anything
# that starts with the name is ignored now.
.env.deploy*

# Generated corpus (500 PDFs + labels; reproducible via `make seed`)
data/synth/out/

# macOS
.DS_Store

# Calibration dataset provenance is committed; the labels sidecar is derived
data/calibration/

# Terraform — patterns are recursive since the config split into
# data-plane/ and compute-plane/ root modules (4c.5a).
infra/terraform/**/.terraform/
infra/terraform/**/*.tfstate
infra/terraform/**/*.tfstate.*
infra/terraform/**/terraform.tfvars
infra/terraform/**/.terraform.lock.hcl
