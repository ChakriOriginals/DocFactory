# Copy to terraform.tfvars and edit. These must MATCH the data layer's values
# or `check "layers_agree"` fails the plan.

aws_region  = "us-east-2"
environment = "dev"
owner       = "your-name"
name_prefix = "docfactory"

# --- cost ---------------------------------------------------------------
# An ALB is $23.73/month all-in for a stable hostname ($16.43 balancer +
# $7.30 for its two public IPv4s). Off by default; the API task
# keeps a public IP and `make api-url` finds it. Turn this on for an afternoon
# when you need a link somebody else can open.
# Who may reach the API on port 8000 when there is no load balancer. Defaults
# to the whole internet if you leave this out -- which is easy to do, because
# nothing prompts you for it. Narrow it to your own address unless you are
# actively demoing to someone else; a home IP changes, so widen it again when
# it stops working rather than leaving it open.
#   api_ingress_cidrs = ["203.0.113.4/32"]
api_ingress_cidrs = ["0.0.0.0/0"]

enable_alb = false

# The only task that runs on an idle stack. 256/512 is the Fargate floor.
api_cpu    = 256
api_memory = 512

# Workers are $0 idle, so their size only decides how fast a burst drains.
worker_cpu    = 512
worker_memory = 1024

# ~70% cheaper, and this pipeline already recovers from interruption by design.
worker_use_spot = true

api_desired_count = 1
worker_min_count  = 0
worker_max_count  = 6

# Hours of continuously-running workers before the dead man's switch parks them.
idle_park_hours    = 3
log_retention_days = 7

# The deployed default. Flip to "anthropic" only for a deliberate short run.
model_provider = "mock"
