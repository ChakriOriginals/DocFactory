# API image.
#
# One image serves two jobs: the API service, and the one-off migration task
# (which overrides the command to `alembic upgrade head`). They share a
# codebase and their dependency sets are near-identical, so a second image
# would be two things to build, push and keep in step for no benefit.
#
# The heavyweight dev groups — WeasyPrint and friends for the synthetic corpus,
# numpy/matplotlib for the calibration study — are deliberately NOT installed:
# they are dev tooling, and shipping them would triple the image for code that
# never runs in production.

FROM python:3.12-slim-bookworm AS base

# Security patch on top of the base image.
#
# The base tag is already current — a fresh pull gives these same package
# versions — but Debian ships point fixes to bookworm-security faster than the
# python image is rebuilt. Of the 19 critical/high findings in this image,
# libpcre2 is the only one with a fix published, so it is the only one pinned
# here. The version is written out rather than a bare `apt-get upgrade` so the
# build stays reproducible: an unpinned upgrade makes the image contents a
# function of the build date. When the pin stops resolving, that is the signal
# to re-run the review, not to drop the pin.
#
# CVE-2026-86145 (libpcre2-8-0). Reachability and the other 18 findings:
# docs/container_cves.md.
RUN apt-get update \
 && apt-get install -y --no-install-recommends libpcre2-8-0=10.42-1+deb12u1 \
 && rm -rf /var/lib/apt/lists/*

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    UV_COMPILE_BYTECODE=1 \
    UV_LINK_MODE=copy \
    UV_PROJECT_ENVIRONMENT=/app/.venv

COPY --from=ghcr.io/astral-sh/uv:0.5.11 /uv /uvx /bin/

WORKDIR /app

# Dependencies first, as their own layer: application code changes on every
# commit, the lockfile rarely, and CI rebuilds on every push. No BuildKit cache
# mounts — this way the image builds under any builder, and CI gets its layer
# caching from the registry instead (cache-from/cache-to in the build action).
COPY pyproject.toml uv.lock ./
COPY packages/core/pyproject.toml packages/core/
COPY packages/evals/pyproject.toml packages/evals/
COPY apps/api/pyproject.toml apps/api/
COPY apps/worker/pyproject.toml apps/worker/

RUN uv sync --frozen --no-install-workspace --package docfactory-api

COPY alembic.ini ./
COPY alembic/ alembic/
COPY config/ config/
# Only the package this image installs. docfactory_evals is the calibration
# harness — a workspace member, not a dependency of api or worker — and it is
# the only code in the repo that shells out (subprocess, in calibrate.py).
# Copying it in shipped a module that was never importable from the venv
# anyway, so leaving it out costs nothing and removes the one call site that
# would have made the image's perl findings reachable. Its pyproject.toml is
# still copied above, because uv needs every workspace member's manifest to
# resolve the lockfile.
COPY packages/core/ packages/core/
COPY apps/ apps/

RUN uv sync --frozen --package docfactory-api

ENV PATH="/app/.venv/bin:${PATH}"

# Non-root: the task role is the security boundary that matters, but a
# container that runs as root for no reason is a finding waiting to happen.
RUN useradd --create-home --uid 10001 docfactory && chown -R docfactory:docfactory /app
USER docfactory

EXPOSE 8000

# One worker process per task; ECS scales tasks, not processes — that way the
# unit of scaling is the same unit CloudWatch measures.
CMD ["uvicorn", "docfactory_api.main:app", "--host", "0.0.0.0", "--port", "8000"]
