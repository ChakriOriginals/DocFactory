# Worker image.
#
# Same base and the same dependency discipline as the API image; the difference
# is the entrypoint and the package it syncs. It runs three consumer threads
# (ingest, parse, extract) in one process — the ingest consumer is what makes
# the S3 -> SQS batch path work without any AWS-specific code.

FROM python:3.12-slim-bookworm AS base

# Security patch on top of the base image.
#
# The base tag is already current — a fresh pull gives these same package
# versions — but Debian ships point fixes to bookworm-security faster than the
# python image is rebuilt. Of the 19 critical/high findings in this image,
# libpcre2 is the only one with a fix published, so it is the only one pinned
# here. The version is written out rather than a bare `apt-get upgrade` so the
# build stays reproducible: an unpinned upgrade makes the image contents a
# function of the build date. When the pin stops resolving, that is the signal
# to re-run the review, not to drop the pin.
#
# CVE-2026-86145 (libpcre2-8-0). Reachability and the other 18 findings:
# docs/container_cves.md.
RUN apt-get update \
 && apt-get install -y --no-install-recommends libpcre2-8-0=10.42-1+deb12u1 \
 && rm -rf /var/lib/apt/lists/*

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    UV_COMPILE_BYTECODE=1 \
    UV_LINK_MODE=copy \
    UV_PROJECT_ENVIRONMENT=/app/.venv

COPY --from=ghcr.io/astral-sh/uv:0.5.11 /uv /uvx /bin/

WORKDIR /app

COPY pyproject.toml uv.lock ./
COPY packages/core/pyproject.toml packages/core/
COPY packages/evals/pyproject.toml packages/evals/
COPY apps/api/pyproject.toml apps/api/
COPY apps/worker/pyproject.toml apps/worker/

RUN uv sync --frozen --no-install-workspace --package docfactory-worker

COPY config/ config/
# Only the package this image installs. docfactory_evals is the calibration
# harness — a workspace member, not a dependency of api or worker — and it is
# the only code in the repo that shells out (subprocess, in calibrate.py).
# Copying it in shipped a module that was never importable from the venv
# anyway, so leaving it out costs nothing and removes the one call site that
# would have made the image's perl findings reachable. Its pyproject.toml is
# still copied above, because uv needs every workspace member's manifest to
# resolve the lockfile.
COPY packages/core/ packages/core/
COPY apps/ apps/

RUN uv sync --frozen --package docfactory-worker

ENV PATH="/app/.venv/bin:${PATH}"

RUN useradd --create-home --uid 10001 docfactory && chown -R docfactory:docfactory /app
USER docfactory

# SIGTERM reaches the process directly (no shell form), so ECS task draining
# lets the consumers finish the message in hand instead of dropping it.
CMD ["python", "-m", "docfactory_worker.main"]
