# Copy to .env for local development. All app code reads config from env vars only.
# Values below match the docker-compose defaults in infra/compose/.

# --- Postgres ---
POSTGRES_USER=docfactory
POSTGRES_PASSWORD=docfactory
POSTGRES_DB=docfactory
# Application connection: a NON-SUPERUSER role, because superusers bypass RLS.
DATABASE_URL=postgresql+psycopg://docfactory_app:docfactory_app@localhost:5432/docfactory
# Owner connection, used only by Alembic (creates tables, roles, policies).
DATABASE_ADMIN_URL=postgresql+psycopg://docfactory:docfactory@localhost:5432/docfactory
APP_DB_PASSWORD=docfactory_app

# --- Object storage (MinIO locally; same code path targets S3 in AWS) ---
# Leave S3_ENDPOINT_URL empty in AWS to use the default credential chain + real S3.
S3_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=docfactory
AWS_REGION=us-east-1

# --- Queues (ElasticMQ locally; same code path targets SQS in AWS) ---
# Leave SQS_ENDPOINT_URL empty in AWS to use the default credential chain + real SQS.
SQS_ENDPOINT_URL=http://localhost:9324
PARSE_QUEUE=docfactory-parse
EXTRACT_QUEUE=docfactory-extract
# After this many failed receives a message moves to the queue's DLQ.
MAX_RECEIVE_COUNT=3

# --- LLM ---
# mock is the default everywhere; switch to anthropic explicitly, on small batches only.
MODEL_PROVIDER=mock
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5
# Documents whose Tier-A text extraction yields fewer chars than this are
# routed to the terminal needs_ocr state (expected for scanned PDFs).
MIN_PARSE_CHARS=100

# --- Tracing ---
PHOENIX_COLLECTOR_ENDPOINT=http://localhost:6006

# --- Tenancy (single hardcoded tenant this phase) ---
DEFAULT_TENANT_ID=dev-tenant
# Seeded for local development; issue real keys via the API.
DEV_API_KEY=dev-local-key

# Batch ingestion (4b). MinIO's webhook target; the API bridge republishes the
# event onto the ingest queue. Empty disables the batch path.
INGEST_NOTIFY_TARGET=arn:minio:sqs::PRIMARY:webhook
INGEST_WEBHOOK_TOKEN=local-ingest-token
