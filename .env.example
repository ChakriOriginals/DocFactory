# Copy to .env for local development. All app code reads config from env vars only.
# Values below match the docker-compose defaults in infra/compose/.

# --- Postgres ---
POSTGRES_USER=docfactory
POSTGRES_PASSWORD=docfactory
POSTGRES_DB=docfactory
DATABASE_URL=postgresql+psycopg://docfactory:docfactory@localhost:5432/docfactory

# --- Object storage (MinIO locally; same code path targets S3 in AWS) ---
# Leave S3_ENDPOINT_URL empty in AWS to use the default credential chain + real S3.
S3_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=docfactory
AWS_REGION=us-east-1

# --- Queues (ElasticMQ locally; same code path targets SQS in AWS) ---
# Leave SQS_ENDPOINT_URL empty in AWS to use the default credential chain + real SQS.
SQS_ENDPOINT_URL=http://localhost:9324
PARSE_QUEUE=docfactory-parse
EXTRACT_QUEUE=docfactory-extract
# After this many failed receives a message moves to the queue's DLQ.
MAX_RECEIVE_COUNT=3

# --- LLM ---
# mock is the default everywhere; switch to anthropic explicitly, on small batches only.
MODEL_PROVIDER=mock
ANTHROPIC_API_KEY=

# --- Tracing ---
PHOENIX_COLLECTOR_ENDPOINT=http://localhost:6006

# --- Tenancy (single hardcoded tenant this phase) ---
DEFAULT_TENANT_ID=dev-tenant
