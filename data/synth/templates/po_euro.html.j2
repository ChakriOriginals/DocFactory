<!DOCTYPE html>
<html>
<head>
<meta charset="utf-8">
<style>
  @page { size: A4; margin: 20mm 18mm; }
  body { font-family: "DejaVu Sans", Verdana, sans-serif; font-size: 9.5pt; color: #222; }
  .head { border-bottom: 1.5px solid #2f4f39; padding-bottom: 4mm; }
  .head .name { font-size: 14pt; font-weight: bold; color: #2f4f39; }
  .head .addr { font-size: 8.5pt; color: #555; margin-top: 2px; }
  .doc-line { font-size: 13pt; font-weight: bold; letter-spacing: 3px; margin-top: 7mm; }
  .parties { width: 100%; border-collapse: collapse; margin-top: 6mm; }
  .parties td { vertical-align: top; font-size: 9.5pt; line-height: 1.45; }
  .parties .k { font-size: 8pt; color: #777; }
  .meta { border-collapse: collapse; margin-left: auto; }
  .meta td { padding: 1.5px 0 1.5px 14px; font-size: 9.5pt; text-align: right; }
  .meta .k { color: #777; }
  .items { width: 100%; border-collapse: collapse; margin-top: 7mm; font-size: 9.5pt; }
  .items th { border-top: 1.2px solid #2f4f39; border-bottom: 1.2px solid #2f4f39;
              padding: 5px 6px; text-align: left; font-size: 8.5pt; }
  .items td { padding: 5px 6px; border-bottom: 0.5px solid #c9d2cb; }
  .num { text-align: right; }
  .totals { border-collapse: collapse; margin-left: auto; margin-top: 5mm; }
  .totals td { padding: 2.5px 0 2.5px 20px; text-align: right; }
  .totals .k { color: #555; }
  .totals .grand td { font-weight: bold; font-size: 11.5pt;
                      border-top: 1.2px solid #2f4f39; padding-top: 5px; }
  .terms { margin-top: 8mm; font-size: 9pt; }
  .footer { margin-top: 10mm; padding-top: 3mm; border-top: 0.5px solid #c9d2cb;
            font-size: 8.5pt; color: #555; }
</style>
</head>
<body>
  <div class="head">
    <div class="name">{{ po.buyer.name }}</div>
    <div class="addr">{{ po.buyer.address_lines | join(" · ") }}{% if po.buyer.email %} · {{ po.buyer.email }}{% endif %}</div>
  </div>

  <div class="doc-line">BESTELLUNG</div>

  <table class="parties">
    <tr>
      <td style="width:55%">
        <div class="k">Lieferant</div>
        Lieferant: {{ po.vendor.name }}<br>
        {% for line in po.vendor.address_lines %}{{ line }}<br>{% endfor %}
        {% if po.vendor.vat_id %}USt-IdNr.: {{ po.vendor.vat_id }}{% endif %}
      </td>
      <td>
        <table class="meta">
          <tr><td class="k">Bestellnummer:</td><td><b>{{ po.po_number }}</b></td></tr>
          <tr><td class="k">Bestelldatum:</td><td>{{ po.order_date | date_eu }}</td></tr>
          <tr><td class="k">Liefertermin:</td><td>{{ po.delivery_date | date_eu }}</td></tr>
        </table>
      </td>
    </tr>
  </table>

  <table class="items">
    <tr>
      <th style="width:6%">Pos.</th>
      <th style="width:52%">Beschreibung</th>
      <th class="num" style="width:8%">Menge</th>
      <th class="num" style="width:17%">Einzelpreis</th>
      <th class="num" style="width:17%">Betrag</th>
    </tr>
    {% for item in po.line_items %}
    <tr>
      <td>{{ loop.index }}</td>
      <td>{{ item.description }}</td>
      <td class="num">{{ item.quantity }}</td>
      <td class="num">{{ item.unit_price | eur }}</td>
      <td class="num">{{ item.amount | eur }}</td>
    </tr>
    {% endfor %}
  </table>

  <table class="totals">
    <tr><td class="k">Zwischensumme</td><td>{{ po.subtotal | eur }}</td></tr>
    <tr><td class="k">Versandkosten</td><td>{{ po.shipping | eur }}</td></tr>
    <tr class="grand"><td class="k">Gesamtbetrag</td><td>{{ po.total | eur }}</td></tr>
  </table>

  <div class="terms">Lieferung innerhalb von {{ po.delivery_days }} Tagen ab Bestelldatum.</div>

  <div class="footer">{{ po.note }}</div>
</body>
</html>
